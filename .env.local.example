# =============================================================================
# RaceCortex Website — Local Development Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# .env.local is listed in .gitignore and will NOT be committed to Git.
# Retrieve production values from 1Password or the Vercel dashboard.
# =============================================================================

# -- Supabase (public — safe to expose to the browser) ----------------------
# Found in: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Found in: Supabase Dashboard → Project Settings → API → anon / public key
# (Legacy naming — do NOT rename to NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY;
#  other RaceCortex services depend on this exact variable name.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -- Supabase (secret — server-side only, NEVER expose to the browser) -------
# Found in: Supabase Dashboard → Project Settings → API → service_role / secret key
# Used by lib/supabase/admin.ts to bypass Row Level Security for trusted
# server-side queries (e.g. checking profiles.beta_active in /api/download).
SUPABASE_SERVICE_ROLE_KEY=

# -- Cloudflare R2 (secret — server-side only) --------------------------------
# The account ID from Cloudflare Dashboard → R2 → Overview (top of page)
R2_ACCOUNT_ID=

# R2 API token credentials (not your Cloudflare account credentials).
# Create at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Permissions needed: Object Read on the racecortex-installers bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The R2 bucket name that holds the installer object.
# Production value: racecortex-installers
R2_BUCKET_NAME=racecortex-installers
